# Copy to .env and adjust as needed.
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=*
TIME_ZONE=Asia/Kolkata

# Leave unset to use local SQLite. Set this to point at Postgres instead,
# e.g. the value docker-compose.yml wires up automatically:
# DATABASE_URL=postgres://eve:eve@db:5432/eve_healthcare
DATABASE_URL=
